# CLI source upload allowlist; Git publication is separately restricted by .gitignore/manifest.
/*
!/app/
!/api/
!/server/
!/scripts/
!/.gitignore
!/.vercelignore
!/README.md
!/DEPLOYMENT.md
!/publication-files.json
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/vercel.json
!/eslint.config.js
/scripts/*
!/scripts/*.mjs
/app/src/assets/*
!/app/src/assets/portrait.jpg
!/app/src/assets/manu-approved.png
!/app/src/assets/manu-chat-portrait.png
node_modules/
dist/
.git/
.vercel/
.env
.env.*
*.pdf
*.docx
*.zip
*.pem
*.key
*.log

!.env.example
